<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="18,16,18,32">
            
            <!-- CEP Section -->
            <Border Style="{StaticResource CardBorder}" Padding="18,16">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                            Offset="0,2" 
                            Radius="8" 
                            Opacity="0.04"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="CEP" 
                           FontSize="12" 
                           FontFamily="OpenSansSemibold" 
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding Logradouro.Cep}" 
                                   Placeholder="00000-000" 
                                   Keyboard="Numeric" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Button Grid.Column="1" 
                                Text="Buscar CEP" 
                                Command="{Binding SearchByCepCommand}" 
                                Style="{StaticResource ButtonPrimary}" 
                                HeightRequest="44" 
                                FontSize="13"
                                Padding="18,0"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Dados do Logradouro -->
            <Border Style="{StaticResource CardBorder}" Padding="18,20">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                            Offset="0,3" 
                            Radius="10" 
                            Opacity="0.04"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    
                    <!-- ID Badge Header -->
                    <Border HorizontalOptions="Start"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                            Padding="10,4"
                            Margin="0,0,0,4">
                        <Label Text="{Binding Logradouro.Id, StringFormat='Logradouro ID: {0}'}" 
                               FontSize="12" 
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                    </Border>

                    <!-- Nome / Rua -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nome/Rua" 
                               FontSize="12" 
                               FontFamily="OpenSansSemibold" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding Logradouro.Nome}" 
                                   Placeholder="Digite o nome da rua..." 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Bairro -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Bairro" 
                               FontSize="12" 
                               FontFamily="OpenSansSemibold" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding Logradouro.Bairro}" 
                                   Placeholder="Digite o bairro..." 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Cidade -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cidade" 
                               FontSize="12" 
                               FontFamily="OpenSansSemibold" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding Logradouro.Cidade}" 
                                   Placeholder="Digite a cidade..." 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Estado -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Estado" 
                               FontSize="12" 
                               FontFamily="OpenSansSemibold" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding Logradouro.Estado}" 
                                   Placeholder="Digite o estado..." 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- País -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="País" 
                               FontSize="12" 
                               FontFamily="OpenSansSemibold" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="12,0"
                                HeightRequest="44">
                            <Entry Text="{Binding Logradouro.Pais}" 
                                   Placeholder="Digite o país..." 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                <Button Grid.Column="0" 
                        Text="Cancelar" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource ButtonSecondary}" 
                        HeightRequest="46"/>
                <Button Grid.Column="1" 
                        Text="Salvar" 
                        Command="{Binding SaveLogradouroCommand}" 
                        Style="{StaticResource ButtonPrimary}" 
                        HeightRequest="46"/>
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator IsVisible="{Binding IsBusy}" 
                               IsRunning="{Binding IsBusy}" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>