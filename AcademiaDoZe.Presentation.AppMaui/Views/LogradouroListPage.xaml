<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*">
        
        <!-- Search Bar com Picker de filtro -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardBorder}" 
                Margin="16,12,16,8"
                Padding="8">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                        Offset="0,2" 
                        Radius="8" 
                        Opacity="0.04"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                
                <!-- Picker de filtro -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 8"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                        Padding="8,0"
                        HeightRequest="42"
                        WidthRequest="120">
                    <Picker Title="" 
                            ItemsSource="{Binding FilterTypes}" 
                            SelectedItem="{Binding SelectedFilterType}" 
                            FontSize="13"
                            VerticalOptions="Center"/>
                </Border>

                <!-- Entry de busca -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 8"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="12,0"
                        HeightRequest="42">
                    <Entry Text="{Binding SearchText}" 
                           Placeholder="Digite o valor..." 
                           FontSize="13"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Botão de busca -->
                <Button Grid.Column="2" 
                        Text="Buscar" 
                        Style="{StaticResource ButtonPrimary}" 
                        FontSize="13" 
                        WidthRequest="80" 
                        HeightRequest="42" 
                        Padding="0"
                        Command="{Binding SearchLogradourosCommand}"/>
            </Grid>
        </Border>

        <!-- Lista de Logradouros (Grid de 3 Cards por Linha) com FAB -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                         Command="{Binding RefreshCommand}"
                         Padding="16,6,16,16">
                
                <CollectionView ItemsSource="{Binding Logradouros}" SelectionMode="None">
                    
                    <!-- 3 Cards por Linha -->
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" 
                                         Span="3" 
                                         HorizontalItemSpacing="12" 
                                         VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <!-- Estado Vazio -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" 
                                             HorizontalOptions="Center"
                                             Spacing="14" 
                                             Padding="24">
                            <Label Text="Nenhum logradouro encontrado" 
                                   HorizontalOptions="Center" 
                                   Style="{StaticResource SubHeadline}"/>
                            <Button Text="Adicionar Primeiro Logradouro" 
                                    Command="{Binding AddLogradouroCommand}" 
                                    Style="{StaticResource ButtonPrimary}" 
                                    HeightRequest="46" 
                                    Padding="24,0"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <!-- Template dos Itens (3 Colunas) -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:LogradouroDto">
                            <Border Style="{StaticResource CardBorder}" 
                                    Padding="14,14">
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                                            Offset="0,3" 
                                            Radius="8" 
                                            Opacity="0.04"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="8">
                                    
                                    <!-- Top Row: CEP Badge + Ações -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" VerticalOptions="Center">
                                        <!-- CEP Badge -->
                                        <Border Grid.Column="0"
                                                HorizontalOptions="Start"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                                StrokeThickness="1"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                                                Padding="6,3">
                                            <Label Text="{Binding Cep}" 
                                                   FontFamily="OpenSansSemibold"
                                                   FontAttributes="Bold" 
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                        </Border>

                                        <!-- Botões de Ação -->
                                        <Button Grid.Column="1" 
                                                Text="Editar" 
                                                Style="{StaticResource ButtonSmall}" 
                                                FontSize="11"
                                                WidthRequest="54"
                                                HeightRequest="28"
                                                Padding="0"
                                                Clicked="OnEditButtonClicked" />
                                        <Button Grid.Column="2" 
                                                Text="Excluir" 
                                                Style="{StaticResource ButtonDanger}" 
                                                FontSize="11"
                                                WidthRequest="54"
                                                HeightRequest="28"
                                                Padding="0"
                                                Clicked="OnDeleteButtonClicked" />
                                    </Grid>

                                    <!-- Logradouro Nome -->
                                    <Label Text="{Binding Nome}" 
                                           FontSize="15" 
                                           FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"
                                           LineBreakMode="TailTruncation"
                                           Margin="0,2,0,0"/>

                                    <!-- Bairro -->
                                    <Label Text="{Binding Bairro}" 
                                           FontSize="12" 
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>

                                    <!-- Cidade - Estado e País -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" 
                                               FontSize="12"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Cidade}"/>
                                                    <Span Text=" - "/>
                                                    <Span Text="{Binding Estado}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Grid.Column="1" 
                                               Text="{Binding Pais}" 
                                               FontSize="11" 
                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Floating Action Button (FAB) -->
            <Button Text="+" 
                    Command="{Binding AddLogradouroCommand}" 
                    Style="{StaticResource ButtonPrimary}" 
                    WidthRequest="56" 
                    HeightRequest="56" 
                    CornerRadius="28"
                    FontSize="24"
                    Padding="0"
                    HorizontalOptions="End" 
                    VerticalOptions="End" 
                    Margin="20">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark=#000000}" 
                            Offset="0,4" 
                            Radius="12" 
                            Opacity="0.35"/>
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" 
                           IsVisible="{Binding IsBusy}" 
                           IsRunning="{Binding IsBusy}" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>